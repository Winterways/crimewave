{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koprulu Idle",
  "version": "0.1.0",
  "identifier": "com.winterways.kopruluidle",
  "build": {
    "beforeDevCommand": "node build.js",
    "beforeBuildCommand": "node build.js",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Koprulu Idle",
        "label": "main",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
